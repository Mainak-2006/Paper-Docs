<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the page, fold and text rules from ic_launcher.xml, rescaled from the
  original 48-unit viewport onto the adaptive icon's 108-unit canvas.

  Only the middle 72x72 of a 108x108 adaptive canvas is guaranteed visible, and launchers mask it
  to a circle, squircle or rounded square depending on the device. The original artwork spans
  13..36 by 7..41 of 48, so its centre sits at (24.5, 24). Mapping that centre onto (54, 54) and
  scaling by 1.647 puts the page inside a 38x56dp footprint, which clears the mask on every shape
  including the worst-case circle.

  The background fill was moved to ic_launcher_background.xml so the two layers can be masked
  independently, which is the whole point of an adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Page, top-right corner folded. -->
    <path
        android:fillColor="#1A73E8"
        android:pathData="M35.1,26.0h24.7l13.2,13.2v42.8h-37.9z" />
    <!-- The fold itself. -->
    <path
        android:fillColor="#8AB4F8"
        android:pathData="M59.8,26.0v13.2h13.2z" />
    <!-- Text rules; stroke width scaled from 2 of 48. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.3"
        android:pathData="M43.3,50.7h19.8M43.3,60.6h19.8M43.3,70.5h13.2" />
</vector>