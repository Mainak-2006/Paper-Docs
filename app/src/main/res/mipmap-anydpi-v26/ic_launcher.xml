<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. minSdk is 26, so every supported device resolves this file and there is
  no need for legacy bitmap densities alongside it. Play supplies the mask; the layers below are
  shaped to survive it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>